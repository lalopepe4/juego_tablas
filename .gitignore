# Secretos: nunca commitear la API key
.env
.env.*

# Basura de Python
__pycache__/
*.pyc

# Copias ligeras para revision (se regeneran con scripts/preparar_revision.py)
Ilustraciones/revision/

# Recortes con transparencia (se regeneran con scripts/recortar_fondos.py)
Ilustraciones/recortes/

# Imagenes descartadas (se conservan fuera del control de versiones)
Ilustraciones/Borradores/

# Entornos virtuales de Python (cualquiera, no solo el del paquete)
.venv/
venv/

# Paquete ilustrador
packages/ilustrador/build/
packages/ilustrador/dist/
*.egg-info/


# Godot editor
.godot/

# Artefactos de exportacion de Godot
juego/*.apk
juego/*.apk.idsig
juego/*.pck

# Temporales de revision
.tmp_revision/
